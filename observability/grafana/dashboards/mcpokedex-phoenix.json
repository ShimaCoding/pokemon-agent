    {
      "id": 14,
      "type": "table",
      "title": "Modelos",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "phoenix-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
