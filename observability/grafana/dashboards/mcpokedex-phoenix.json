          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM s.end_time - s.start_time)) AS p95\nFROM spans s\nJOIN traces t ON t.id = s.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND s.parent_id IS NULL AND s.span_kind = 'AGENT' AND $__timeFilter(s.start_time)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
