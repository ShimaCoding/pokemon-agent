      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Costo estimado",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "phoenix-pg"
      },
      "gridPos": {
        "x": 16,
