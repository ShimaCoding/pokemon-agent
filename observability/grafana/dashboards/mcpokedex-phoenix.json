          "rawSql": "SELECT count(*) FILTER (WHERE sa.label = 'thumbs_up') AS \"👍\", count(*) FILTER (WHERE sa.label = 'thumbs_down') AS \"👎\"\nFROM span_annotations sa\nJOIN spans s ON s.id = sa.span_rowid\nJOIN traces t ON t.id = s.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND sa.name = 'user_feedback' AND $__timeFilter(s.start_time)"
