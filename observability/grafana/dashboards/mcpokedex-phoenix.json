            "uid": "phoenix-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(sc.total_cost), 0) AS usd\nFROM span_costs sc\nJOIN traces t ON t.id = sc.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND $__timeFilter(sc.span_start_time)"
        }
