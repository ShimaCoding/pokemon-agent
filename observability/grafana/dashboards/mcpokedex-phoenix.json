    {
      "id": 17,
      "type": "table",
      "title": "Evals por reglas (pass rate)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "phoenix-pg"
      },
      "gridPos": {
        "x": 12,
