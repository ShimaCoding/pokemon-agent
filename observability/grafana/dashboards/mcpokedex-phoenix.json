      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "phoenix-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT s.attributes #>> '{llm,provider}' AS proveedor, s.attributes #>> '{llm,model_name}' AS modelo, count(*) AS llamadas, count(*) FILTER (WHERE s.status_code = 'ERROR') AS fallidas, sum(s.llm_token_count_prompt) AS prompt, sum(s.llm_token_count_completion) AS completion, round(avg(extract(epoch FROM s.end_time - s.start_time))::numeric, 2) AS seg_promedio\nFROM spans s\nJOIN traces t ON t.id = s.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND s.span_kind = 'LLM' AND $__timeFilter(s.start_time)\nGROUP BY 1, 2 ORDER BY llamadas DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
