      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "phoenix-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT sa.name AS eval, count(*) AS turnos, round(100.0 * avg(sa.score)::numeric, 1) AS pass_pct\nFROM span_annotations sa\nJOIN spans s ON s.id = sa.span_rowid\nJOIN traces t ON t.id = s.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND sa.annotator_kind = 'CODE' AND $__timeFilter(s.start_time)\nGROUP BY 1 ORDER BY pass_pct"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
