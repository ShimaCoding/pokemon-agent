        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "span_costs de Phoenix (precios incorporados por modelo)."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Feedback 👍 / 👎",
      "datasource": {
        "type": "grafana-postgresql-datasource",
