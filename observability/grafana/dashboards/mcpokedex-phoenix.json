    },
    {
      "id": 18,
      "type": "table",
      "title": "Tools",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "phoenix-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
