    {
      "id": 3,
      "type": "stat",
      "title": "% con error",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "phoenix-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
