          "rawSql": "SELECT $__timeGroupAlias(sc.span_start_time, $__interval, 0), sum(sc.total_cost) AS usd\nFROM span_costs sc\nJOIN traces t ON t.id = sc.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND $__timeFilter(sc.span_start_time)\nGROUP BY 1 ORDER BY 1"
