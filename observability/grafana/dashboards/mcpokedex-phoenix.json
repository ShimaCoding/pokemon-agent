          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT s.name AS tool, count(*) AS llamadas, round(100.0 * count(*) FILTER (WHERE s.status_code = 'ERROR') / count(*), 1) AS error_pct, round(percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM s.end_time - s.start_time))::numeric, 2) AS p95_seg, count(*) FILTER (WHERE s.attributes #>> '{metadata,cache}' = 'hit') AS cache_hits\nFROM spans s\nJOIN traces t ON t.id = s.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND s.span_kind = 'TOOL' AND $__timeFilter(s.start_time)\nGROUP BY 1 ORDER BY llamadas DESC"
        }
      ],
      "fieldConfig": {
