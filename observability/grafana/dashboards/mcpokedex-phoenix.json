      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "phoenix-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(s.start_time, $__interval, 0), sum(s.llm_token_count_prompt) AS prompt, sum(s.llm_token_count_completion) AS completion, sum((s.attributes #>> '{llm,token_count,prompt_details,cache_read}')::int) AS cache_read\nFROM spans s\nJOIN traces t ON t.id = s.trace_rowid\nJOIN projects p ON p.id = t.project_rowid\nWHERE p.name = '$project' AND s.span_kind = 'LLM' AND $__timeFilter(s.start_time)\nGROUP BY 1 ORDER BY 1"
