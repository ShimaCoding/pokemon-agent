GROQ_API_KEY=your_groq_api_key_here

# Security (leave blank to disable for local dev)
API_KEY=                          # Clients send X-API-Key: <value> → no rate limit + gpt-oss-120b; leave blank to disable
ALLOWED_ORIGINS=                  # Comma-separated origins, e.g. https://midominio.com; leave blank for *
MCP_SERVER_URL=                   # e.g. http://localhost:8001/mcp; blank uses https://mcp.mcpokedex.com/mcp

# Reasoning effort for gpt-oss (low | medium | high). Invalid values fall back to the default.
REASONING_EFFORT_ROUTING=         # Default: low (call that opens a turn: picks a tool or answers off-topic)
REASONING_EFFORT_FINAL=           # Default: medium (calls after tool results: the narration)

# Conversation memory (harness session snapshots)
SESSIONS_DIR=                     # Default: data/sessions
SESSION_TTL_SECONDS=              # Default: 86400 (conversations idle longer are deleted)

# get_pokedex_entry result cache (in process, emptied on restart)
TOOL_CACHE_ENABLED=               # Default: on; 0/false turns it off
TOOL_CACHE_TTL_SECONDS=           # Default: 86400
TOOL_CACHE_MAX_ENTRIES=           # Default: 512

# Tracing: Datadog LLM Observability and/or Phoenix, each enabled by its own vars (both may be on).
# DD_ENV below also names the env of both backends (Phoenix project mcpokedex-<env>).

# Phoenix (backend/telemetry_phoenix.py). Blank endpoint disables it.
PHOENIX_COLLECTOR_ENDPOINT=       # Phoenix base URL, e.g. http://localhost:6006; prod: http://mcpokedex-phoenix:6006
PHOENIX_API_KEY=                  # System API key (Phoenix → Settings), needed when Phoenix has auth on
PHOENIX_PROJECT_NAME=             # Default: mcpokedex-<DD_ENV or local>

# Datadog LLM Observability (ddtrace SDK agentless). Blank key disables it.
DD_API_KEY=
DD_SITE=                          # Default: datadoghq.com
DD_LLMOBS_ML_APP=                 # Default: McpokedexAgent
DD_ENV=                           # Default: local (docker-compose.yml pins prod). Use preview on the preview host.
DD_VERSION=                       # Default: git commit (7 chars). Set only to label uncommitted local experiments, e.g. abc1234-ttl
