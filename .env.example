GROQ_API_KEY=your_groq_api_key_here

# Security (leave blank to disable for local dev)
API_KEY=                          # Clients send X-API-Key: <value> → no rate limit + gpt-oss-120b; leave blank to disable
ALLOWED_ORIGINS=                  # Comma-separated origins, e.g. https://midominio.com; leave blank for *
MCP_SERVER_URL=                   # e.g. http://localhost:8001/mcp; blank uses https://mcp.mcpokedex.com/mcp

# Conversation memory (harness session snapshots)
SESSIONS_DIR=                     # Default: data/sessions
SESSION_TTL_SECONDS=              # Default: 86400 (conversations idle longer are deleted)

# Tracing (Datadog LLM Observability via OTLP, agentless). Blank disables it.
DD_API_KEY=
DD_SITE=                          # Default: datadoghq.com
DD_LLMOBS_ML_APP=                 # Default: McpokedexAgent
